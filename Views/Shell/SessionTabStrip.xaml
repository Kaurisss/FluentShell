<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentShell.Views.Shell.SessionTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center">
        <ScrollViewer
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel x:Name="TabPanel" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                <Button
                    x:Name="NewSessionButton"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    Margin="0,0,4,0"
                    Style="{StaticResource TitleBarSessionIconButtonStyle}"
                    Click="NewSessionButton_Click"
                    ToolTipService.ToolTip="打开新连接"
                    AutomationProperties.Name="打开新连接">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </UserControl>