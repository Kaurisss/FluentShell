<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentShell.Views.Shell.SessionTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="TabStrip_Loaded"
    Unloaded="TabStrip_Unloaded"
    SizeChanged="TabLayout_SizeChanged">
    <Grid x:Name="TabStripLayout" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="ScrollLeftButton"
            Width="32"
            Height="32"
            MinWidth="32"
            Padding="0"
            Visibility="Collapsed"
            Style="{StaticResource TitleBarSessionIconButtonStyle}"
            Click="ScrollLeftButton_Click"
            ToolTipService.ToolTip="向左滚动标签页"
            AutomationProperties.Name="向左滚动标签页"
            AutomationProperties.AutomationId="ScrollSessionTabsLeft">
            <PathIcon x:Name="CaretLeftIcon" Width="12" Height="12" />
        </Button>
        <ScrollViewer
            x:Name="TabScrollViewer"
            Grid.Column="1"
            Background="Transparent"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled"
            SizeChanged="TabLayout_SizeChanged"
            ViewChanged="TabScrollViewer_ViewChanged">
            <StackPanel x:Name="TabPanel" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center" SizeChanged="TabLayout_SizeChanged" />
        </ScrollViewer>
        <Button
            x:Name="ScrollRightButton"
            Grid.Column="2"
            Width="32"
            Height="32"
            MinWidth="32"
            Padding="0"
            Visibility="Collapsed"
            Style="{StaticResource TitleBarSessionIconButtonStyle}"
            Click="ScrollRightButton_Click"
            ToolTipService.ToolTip="向右滚动标签页"
            AutomationProperties.Name="向右滚动标签页"
            AutomationProperties.AutomationId="ScrollSessionTabsRight">
            <PathIcon x:Name="CaretRightIcon" Width="12" Height="12" />
        </Button>
        <Button
            x:Name="NewSessionButton"
            Grid.Column="3"
            Width="32"
            Height="32"
            MinWidth="32"
            Margin="4,0,0,0"
            Style="{StaticResource TitleBarSessionIconButtonStyle}"
            Click="NewSessionButton_Click"
            ToolTipService.ToolTip="新建标签页"
            AutomationProperties.Name="新建标签页"
            AutomationProperties.AutomationId="NewSessionTab">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
        </Button>
    </Grid>
</UserControl>
