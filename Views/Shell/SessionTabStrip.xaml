<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentShell.Views.Shell.SessionTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="TabPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button
            x:Name="NewSessionButton"
            Style="{StaticResource TitleBarSessionIconButtonStyle}"
            Click="NewSessionButton_Click"
            ToolTipService.ToolTip="打开新连接"
            AutomationProperties.Name="打开新连接">
            <FontIcon Glyph="&#xE710;" FontSize="16" />
        </Button>
    </StackPanel>
</UserControl>