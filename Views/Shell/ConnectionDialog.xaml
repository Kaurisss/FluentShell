<ContentDialog
    x:Class="FluentShell.Views.Shell.ConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="连接服务器"
    CloseButtonText="取消连接"
    DefaultButton="Close"
    CornerRadius="8">
    <StackPanel Spacing="16" MinWidth="320">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing
                x:Name="ConnectionProgressRing"
                Width="24"
                Height="24"
                IsActive="True" />
            <TextBlock
                x:Name="ConnectionMessageText"
                Text="正在连接..."
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
