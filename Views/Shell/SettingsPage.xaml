<UserControl
    x:Class="FluentShell.Views.Shell.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="28" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="外观与连接" Style="{StaticResource PageHeadingStyle}" />
                <TextBlock Text="设置只影响当前 Windows 用户。" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Spacing="9">
                <TextBlock Text="主题" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeComboBox" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged" MinWidth="220">
                    <ComboBoxItem Content="系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="9">
                <TextBlock Text="背景效果" FontWeight="SemiBold" />
                <ComboBox x:Name="BackdropMaterialComboBox" SelectedIndex="0" SelectionChanged="BackdropMaterialComboBox_SelectionChanged" MinWidth="220">
                    <ComboBoxItem Content="Mica（云母）" />
                    <ComboBoxItem Content="亚克力" />
                </ComboBox>
                <TextBlock Text="Mica 更稳定省电；亚克力会透出窗口后方内容。" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="9">
                <TextBlock Text="终端字号" FontWeight="SemiBold" />
                <NumberBox x:Name="TerminalFontSizeBox" Value="14" Minimum="11" Maximum="24" SpinButtonPlacementMode="Inline" ValueChanged="TerminalFontSizeBox_ValueChanged" MinWidth="220" />
            </StackPanel>
            <StackPanel Spacing="9">
                <TextBlock Text="默认下载目录" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadDirectoryBox" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="选择目录" Click="ChooseDownloadDirectoryButton_Click" />
                </Grid>
            </StackPanel>
            <Border Padding="18" Background="{ThemeResource PanelSurfaceBrush}" BorderBrush="{ThemeResource SubtleStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="本地数据" FontWeight="SemiBold" />
                    <TextBlock x:Name="DataLocationText" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                    <Button Content="清除服务器配置" Click="ClearLocalDataButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>