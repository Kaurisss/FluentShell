<UserControl
    x:Class="FluentShell.Views.Shell.TransferCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:FluentShell.Views.Shell"
    xmlns:icons="using:FluentIcons.WinUI">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedTasks" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="8,4,16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:SymbolIcon Symbol="ArrowSwap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="传输任务" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <ComboBox x:Name="FilterBox" Grid.Row="1" Margin="8,0,24,0" MinHeight="40" SelectedIndex="0"
                  SelectionChanged="Filter_Changed" AutomationProperties.Name="筛选传输任务" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="shell:TransferFilterOption">
                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid Grid.Row="2">
            <!-- Only the task list scrolls; its viewport reaches the flyout edge. -->
            <ListView x:Name="TaskList" Padding="8,0,24,0" ItemsSource="{Binding Source={StaticResource GroupedTasks}}"
                      SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="按连接分组的传输任务"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewHeaderItemDividerStroke" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{ThemeResource MutedTextBrush}"
                                           Margin="4,8,0,12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <shell:TransferTaskCard Task="{Binding}" DiscardRequested="TaskCard_DiscardRequested" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" Margin="24,0,40,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <icons:SymbolIcon Symbol="ArrowSwap" Foreground="{ThemeResource MutedTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="EmptyTitle" Text="暂无传输任务" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="各服务器的上传和下载任务会统一显示在这里。"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
