<UserControl
    x:Class="FluentShell.Views.Shell.TransferCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FluentShell.Views.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <converters:StringToVisibilityConverter x:Key="TextVisibility" />
        <CollectionViewSource x:Name="GroupedTasks" IsSourceGrouped="True" />
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,16,0">
            <TextBlock Text="传输任务" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="关闭" HorizontalAlignment="Right" Click="Close_Click" AutomationProperties.Name="收起传输任务" />
        </Grid>
        <ComboBox x:Name="FilterBox" Grid.Row="1" Margin="0,0,16,0" SelectedIndex="0" SelectionChanged="Filter_Changed"
                  AutomationProperties.Name="筛选传输任务" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="全部任务" />
            <ComboBoxItem Content="进行中（含暂停）" />
            <ComboBoxItem Content="已结束" />
        </ComboBox>
        <Grid Grid.Row="2">
            <!-- 内容保留右侧间距，滚动视口延伸至浮窗边缘。 -->
            <ListView x:Name="TaskList" Padding="0,0,16,0" ItemsSource="{Binding Source={StaticResource GroupedTasks}}"
                      SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,12,0,8"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,12" RowSpacing="8" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Direction}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding Target}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding Target}" Foreground="{ThemeResource MutedTextBrush}" />
                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" />
                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressLabel}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{Binding PauseLabel}" Click="Pause_Click" Visibility="{Binding CanPause, Converter={StaticResource BoolVisibility}}" />
                                    <Button Content="重试" Click="Retry_Click" IsEnabled="{Binding CanRetry}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"
                                            ToolTipService.ToolTip="重新执行本批任务；已有文件会再次确认覆盖" />
                                    <Button Content="丢弃" Click="Discard_Click" ToolTipService.ToolTip="停止并移除任务，保留已传输的部分文件" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="4" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                       MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}" />
                            <Expander Grid.Row="5" Header="{Binding FileSummary}" HorizontalAlignment="Stretch" Padding="0"
                                      HorizontalContentAlignment="Stretch" Visibility="{Binding HasFiles, Converter={StaticResource BoolVisibility}}">
                                <ListView ItemsSource="{Binding Files}" MaxHeight="180" Padding="16,8,16,8" SelectionMode="None" HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="36" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding RelativePath}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding RelativePath}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource TextVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="暂无传输任务" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="各服务器的上传和下载任务会统一显示在这里。" TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
