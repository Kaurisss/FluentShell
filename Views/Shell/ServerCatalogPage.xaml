<UserControl
    x:Class="FluentShell.Views.Shell.ServerCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="WideProfileTemplate">
            <Border Margin="0,0,0,8" Padding="14,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Notes}">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Address}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Address}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Username}" MaxWidth="120" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AuthenticationLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Width="32" Height="36" MinWidth="32" Style="{StaticResource TitleBarSessionIconButtonStyle}" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Tag="{Binding}" Click="ConnectButton_Click" ToolTipService.ToolTip="连接" AutomationProperties.Name="连接" />
                        <Button Width="32" Height="36" MinWidth="32" Style="{StaticResource TitleBarSessionIconButtonStyle}" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="CopyButton_Click" ToolTipService.ToolTip="复制" AutomationProperties.Name="复制" />
                        <Button Width="32" Height="36" MinWidth="32" Style="{StaticResource TitleBarSessionIconButtonStyle}" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="EditButton_Click" ToolTipService.ToolTip="编辑" AutomationProperties.Name="编辑" />
                        <Button Width="32" Height="36" MinWidth="32" Style="{StaticResource TitleBarSessionIconButtonStyle}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="DeleteButton_Click" ToolTipService.ToolTip="删除" AutomationProperties.Name="删除" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Toolbar" ColumnSpacing="8" RowSpacing="12" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.ColumnSpan="4" AutomationProperties.Name="搜索服务器" x:Name="SearchBox" PlaceholderText="搜索名称、主机或用户名" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortComboBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" AutomationProperties.Name="服务器排序" SelectedIndex="0" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="按名称排序" />
                <ComboBoxItem Content="按最近连接" />
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Content="刷新" Click="RefreshButton_Click" />
            <Button x:Name="AddButton" Grid.Row="1" Grid.Column="3" Content="添加服务器" Style="{StaticResource AppAccentButtonStyle}" Click="AddButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ProfileCountText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="ProfilesList" IsItemClickEnabled="False" SelectionMode="None" Padding="0" ItemTemplate="{StaticResource WideProfileTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel x:Name="EmptyState" Padding="0,32" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="EmptyStateTitle" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="EmptyStateDescription" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
