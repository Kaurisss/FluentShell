<UserControl
    x:Class="FluentShell.Views.Shell.ServerCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Toolbar" ColumnSpacing="10" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、主机或用户名" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="按名称排序" />
                <ComboBoxItem Content="按最近连接" />
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="RefreshButton_Click" />
            <Button x:Name="AddButton" Grid.Column="3" Content="添加服务器" Style="{StaticResource AppAccentButtonStyle}" Click="AddButton_Click" />
        </Grid>
        <Grid x:Name="ListHeader" Grid.Row="1" Padding="14,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="服务器" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" Text="地址" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
            <TextBlock Grid.Column="2" Text="用户" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
        </Grid>
        <ListView Grid.Row="2" x:Name="ProfilesList" IsItemClickEnabled="True" ItemClick="ProfilesList_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Username}" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Tag="{Binding}" Click="ConnectButton_Click" ToolTipService.ToolTip="连接" AutomationProperties.Name="连接" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="CopyButton_Click" ToolTipService.ToolTip="复制" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="EditButton_Click" ToolTipService.ToolTip="编辑" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="DeleteButton_Click" ToolTipService.ToolTip="删除" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>