<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FluentShell.Views.Shell.FileConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文件已存在"
    PrimaryButtonText="覆盖"
    SecondaryButtonText="跳过"
    CloseButtonText="取消全部"
    DefaultButton="Primary"
    CornerRadius="8">
    <ContentDialog.Resources>
        <!-- 为所有对话框按钮设置圆角 -->
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.SecondaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.SecondaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.CloseButtonStyle>
    <StackPanel Spacing="16" MinWidth="400">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <CheckBox x:Name="ApplyToAllCheckBox" Content="应用到全部冲突文件" />
    </StackPanel>
</ContentDialog>
