<UserControl
    x:Class="FluentShell.Views.Shell.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.WinUI">

    <ScrollViewer
        x:Name="RootScrollViewer"
        HorizontalContentAlignment="Left"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        SizeChanged="RootScrollViewer_SizeChanged">
        <StackPanel x:Name="RootContent" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left" Padding="0,0,0,28">
            <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectServerButton" MinHeight="36" Padding="16,0" Content="连接服务器" Style="{StaticResource AppAccentButtonStyle}" Click="ConnectServerButton_Click" />
                <Button MinHeight="36" Padding="16,0" Content="添加服务器" Click="AddServerButton_Click" />
            </StackPanel>
            <TextBlock x:Name="ConnectionSectionTitle" Style="{StaticResource SectionHeadingStyle}" />
            <ItemsRepeater x:Name="ConnectionCards">
                <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="88" Padding="14,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6"><icons:SymbolIcon Symbol="Server" Width="18" Height="18" FontSize="18" /></Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Address}" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Address}" />
                                    <TextBlock Text="{Binding LastConnectedLabel}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" MinHeight="36" Padding="16,0" VerticalAlignment="Center" Content="连接" Tag="{Binding}" Click="ConnectButton_Click" AutomationProperties.Name="连接服务器" AutomationProperties.HelpText="{Binding Name}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel x:Name="EmptyState" Spacing="12" Padding="0,32" Visibility="Collapsed">
                <TextBlock Text="还没有已保存的服务器" FontSize="16" FontWeight="SemiBold" />
                <Button Content="添加服务器" HorizontalAlignment="Left" Click="AddServerButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
