<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentShell.Views.Shell.ConnectedServerSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Stretch">
        <StackPanel x:Name="ExpandedPanel" Margin="16,16,12,0" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock x:Name="ServerNameText" Text="服务器" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ServerStatusText" Text="正在连接" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                <Button
                    x:Name="ReconnectButton"
                    Content="重新连接"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AppAccentButtonStyle}"
                    Visibility="Collapsed"
                    Click="ReconnectButton_Click"
                    AutomationProperties.Name="重新连接服务器"
                    ToolTipService.ToolTip="重新连接服务器" />
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock x:Name="AddressText" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="UserText" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="服务器状态" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                <StackPanel x:Name="MetricsPanel" Spacing="12" />
            </StackPanel>
        </StackPanel>

            <StackPanel
            x:Name="CompactPanel"
            Width="52"
            HorizontalAlignment="Center"
            Visibility="Collapsed"
            Margin="0,16,0,12"
            Spacing="14"
            SizeChanged="CompactPanel_SizeChanged"
            VerticalAlignment="Stretch">
            <StackPanel.RenderTransform>
            <TranslateTransform X="4" />
            </StackPanel.RenderTransform>
            <StackPanel x:Name="CompactReconnectPanel" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="已断开" FontSize="10" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" />
                <Button
                    x:Name="CompactReconnectButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Style="{StaticResource AppAccentButtonStyle}"
                    Click="ReconnectButton_Click"
                    AutomationProperties.Name="重新连接服务器"
                    ToolTipService.ToolTip="重新连接服务器">
                    <SymbolIcon Symbol="Refresh" Width="20" Height="20" />
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="CompactConnectingPanel"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.Name="正在连接服务器"
                ToolTipService.ToolTip="正在连接服务器">
                <ProgressRing x:Name="CompactConnectionProgressRing" Width="20" Height="20" IsActive="False" />
            </StackPanel>

            <StackPanel x:Name="CompactMetricsPanel" Spacing="14" Visibility="Collapsed">
                <Grid RowSpacing="4" ColumnSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" FontSize="10" />
                    <TextBlock x:Name="CompactCpuText" Grid.Column="1" FontSize="10" />
                    <Grid x:Name="CompactCpuTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SubtleStrokeBrush}" CornerRadius="2.5" />
                        <Border x:Name="CompactCpuFill" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
                <Grid RowSpacing="4" ColumnSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="内存" FontSize="10" />
                    <TextBlock x:Name="CompactMemoryText" Grid.Column="1" FontSize="10" />
                    <Grid x:Name="CompactMemoryTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SubtleStrokeBrush}" CornerRadius="2.5" />
                        <Border x:Name="CompactMemoryFill" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
                <Grid RowSpacing="4" ColumnSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Swap" FontSize="10" />
                    <TextBlock x:Name="CompactSwapText" Grid.Column="1" FontSize="10" />
                    <Grid x:Name="CompactSwapTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SubtleStrokeBrush}" CornerRadius="2.5" />
                        <Border x:Name="CompactSwapFill" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>