<Window
    x:Class="FluentShell.Views.ServerProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="WarningTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="ToastCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource InfoBarCloseButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="EditorTitleBar" Background="Transparent">
            <TextBlock x:Name="WindowTitle" Margin="16,0,150,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid x:Name="EditorHost" Grid.Row="1" Margin="0,16,0,0" />
        <Border Grid.Row="2" Padding="32,20" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="12">
                <TextBlock x:Name="ValidationError" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel x:Name="TrustPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="TrustMessage" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcceptTrustButton" Content="信任并测试" />
                        <Button x:Name="RejectTrustButton" Content="拒绝" />
                    </StackPanel>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestButton" Content="测试连接" MinHeight="32" HorizontalAlignment="Stretch" AutomationProperties.Name="测试连接" ToolTipService.ToolTip="测试连接" />
                    <Button x:Name="SaveButton" Grid.Column="1" Content="保存" HorizontalAlignment="Stretch" Style="{StaticResource AppAccentButtonStyle}" />
                    <Button x:Name="SaveAndConnectButton" Grid.Column="2" Content="保存并连接" HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="ToastSurface" Grid.Row="1" Grid.RowSpan="2" Canvas.ZIndex="10" Visibility="Collapsed"
                MaxWidth="560" Margin="24,12,24,24" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <InfoBar x:Name="ConnectionTestInfoBar" IsOpen="False" IsClosable="True" CornerRadius="8"
                     CloseButtonStyle="{StaticResource ToastCloseButtonStyle}" />
        </Border>
    </Grid>
</Window>
