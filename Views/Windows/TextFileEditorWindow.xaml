<Window
    x:Class="FluentShell.Views.Session.TextFileEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:WinUIEditor"
    xmlns:icons="using:FluentIcons.WinUI">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="Root_Loaded" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="Close_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="EditorTitleBar" Margin="16,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <icons:SymbolIcon x:Name="DocumentEditIcon" Symbol="DocumentEdit" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock x:Name="WindowTitle" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TextEditorTitle" />
        </Grid>
        <Grid Grid.Row="1" Margin="12,4,12,8" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="EditorToolbar" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SaveButton" Click="Save_Click" ToolTipService.ToolTip="保存（Ctrl+S）" AutomationProperties.Name="保存文件">
                        <StackPanel Orientation="Horizontal" Spacing="8"><icons:SymbolIcon Symbol="Save" /></StackPanel>
                    </Button>
                    <Button x:Name="UndoButton" Click="Undo_Click" ToolTipService.ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销"><icons:SymbolIcon Symbol="ArrowUndo" /></Button>
                    <Button x:Name="RedoButton" Click="Redo_Click" ToolTipService.ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做"><icons:SymbolIcon Symbol="ArrowRedo" /></Button>
                    <Button x:Name="FindButton" Click="Find_Click" ToolTipService.ToolTip="查找（Ctrl+F）" AutomationProperties.Name="查找"><icons:SymbolIcon Symbol="Search" /></Button>
                    <Button x:Name="SettingsButton" ToolTipService.ToolTip="编辑器设置" AutomationProperties.Name="编辑器设置" AutomationProperties.AutomationId="TextEditorSettings">
                        <icons:SymbolIcon Symbol="Settings" />
                        <Button.Flyout>
                            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedLeft">
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Width="260" Spacing="12">
                                        <TextBlock Text="编辑器设置" FontSize="16" FontWeight="SemiBold" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="编辑" Foreground="{ThemeResource MutedTextBrush}" />
                                            <CheckBox x:Name="ReadOnlyBox" Content="只读" IsChecked="True" Checked="ReadOnly_Changed" Unchecked="ReadOnly_Changed" />
                                            <CheckBox x:Name="WrapBox" Content="自动换行" IsChecked="False" Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="显示" Foreground="{ThemeResource MutedTextBrush}" />
                                            <CheckBox x:Name="LineNumbersBox" Content="显示行号" IsChecked="True" Checked="LineNumbers_Changed" Unchecked="LineNumbers_Changed" />
                                            <CheckBox x:Name="WhitespaceBox" Content="显示空白字符" IsChecked="False" Checked="Whitespace_Changed" Unchecked="Whitespace_Changed" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <ComboBox x:Name="IndentWidthBox" Header="缩进宽度" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="IndentWidth_Changed">
                                                <ComboBoxItem Content="2 个字符" />
                                                <ComboBoxItem Content="4 个字符" />
                                                <ComboBoxItem Content="8 个字符" />
                                            </ComboBox>
                                            <CheckBox x:Name="UseTabsBox" Content="使用 Tab 缩进" IsChecked="False" Checked="UseTabs_Changed" Unchecked="UseTabs_Changed" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="PathText" Grid.Row="1" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid x:Name="FindPanel" Grid.Row="2" Margin="12,0,12,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" PlaceholderText="查找文本" AutomationProperties.Name="查找文本" IsSpellCheckEnabled="False" KeyDown="FindBox_KeyDown" />
            <Button Grid.Column="1" Content="下一个" Click="FindNext_Click" />
            <Button Grid.Column="2" Click="HideFind_Click" AutomationProperties.Name="关闭查找"><icons:SymbolIcon Symbol="Dismiss" /></Button>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="3" Margin="12,0,12,8" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="DiscardButton" Content="放弃修改并关闭" Visibility="Collapsed" Click="Discard_Click" /></InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="4">
            <editor:CodeEditorControl x:Name="CodeEditor" Background="Transparent" AutomationProperties.Name="文件文本" AutomationProperties.AutomationId="TextEditorContent" />
            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40" AutomationProperties.Name="正在读取文本" />
        </Grid>
        <Grid Grid.Row="5" Margin="16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FileStatus" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CaretStatus" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
        </Grid>
    </Grid>
</Window>
