<UserControl
    x:Class="FluentShell.Views.Session.SftpWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.DataGrid">
    <UserControl.Resources>
        <!-- The grid outer border supplies the final header's right edge. -->
        <Style x:Key="LastRemoteHeaderStyle" TargetType="syncfusion:GridHeaderCellControl">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <DataTemplate x:Key="RemoteFileNameCellTemplate">
            <Grid Margin="12,0,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Text="{Binding IconGlyph}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="0,8,0,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                PlaceholderText="远程路径"
                FontFamily="Cascadia Mono"
                FontSize="12"
                Height="36"
                MinHeight="0"
                Padding="10,10,6,10"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                IsSpellCheckEnabled="False"
                KeyDown="PathBox_KeyDown" />
            <StackPanel
                x:Name="WorkspaceOperationStatusPanel"
                Grid.Column="1"
                Margin="8,0,8,0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="WorkspaceOperationStatus"
                    MaxWidth="220"
                    FontSize="12"
                    Foreground="{ThemeResource MutedTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <CommandBar
                x:Name="Toolbar"
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <CommandBar.Resources>
                    <!-- Do not reserve trailing space when the overflow button is hidden. -->
                    <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                </CommandBar.Resources>
                <AppBarButton
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="刷新"
                    Icon="Refresh"
                    ToolTipService.ToolTip="刷新"
                    Click="RefreshButton_Click" />
                <AppBarButton
                    x:Name="UploadButton"
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="上传"
                    Icon="Upload"
                    ToolTipService.ToolTip="上传"
                    Click="UploadButton_Click" />
                <AppBarButton
                    x:Name="DownloadButton"
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="下载"
                    Icon="Download"
                    ToolTipService.ToolTip="下载"
                    Click="DownloadButton_Click">
                    <AppBarButton.Resources>
                        <!-- Align the last visible border with the file grid's right edge. -->
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">2,2,0,2</Thickness>
                    </AppBarButton.Resources>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <syncfusion:SfDataGrid
            x:Name="RemoteTable"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionUnit="Row"
            CurrentCellBorderThickness="0"
            AllowSorting="True"
            AllowFiltering="True"
            AllowResizingColumns="False"
            AllowDraggingColumns="False"
            AllowGrouping="False"
            AllowRowHoverHighlighting="True"
            ShowRowHeader="False"
            HeaderRowHeight="40"
            RowHeight="40"
            FontSize="14"
            ColumnWidthMode="AutoLastColumnFill" />

        <!-- Cover both the path toolbar and the file list without changing their layout. -->
        <Grid x:Name="DirectoryLoadingOverlay" Grid.RowSpan="2"
              Visibility="Collapsed" Background="Transparent">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.8" />
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        MaxWidth="280" Margin="24" Spacing="12">
                <TextBlock Text="正在读取文件夹…" HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="DirectoryLoadingProgress" IsIndeterminate="False"
                             AutomationProperties.Name="正在读取文件夹" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
