<UserControl
    x:Class="FluentShell.Views.Session.SftpWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.DataGrid">

    <Grid Padding="0,8,0,10" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CollapseButton"
                Content="&#xE70D;"
                FontFamily="Segoe Fluent Icons"
                FontSize="16"
                Style="{StaticResource TitleBarSessionIconButtonStyle}"
                AutomationProperties.Name="收起 SFTP 文件管理器"
                ToolTipService.ToolTip="收起 SFTP 文件管理器"
                Click="CollapseButton_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="SFTP 文件管理器" FontSize="15" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SelectionStatus"
                    Text="0 项"
                    FontSize="12"
                    Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
            <CommandBar
                x:Name="Toolbar"
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <AppBarButton Label="上一级" Icon="Up" Click="NavigateUpButton_Click" />
                <AppBarButton Label="刷新" Icon="Refresh" Click="RefreshButton_Click" />
                <AppBarButton Label="新建文件夹" Icon="Add" Click="NewFolderButton_Click" />
                <AppBarButton Label="上传" Icon="Upload" Click="UploadButton_Click" />
                <AppBarButton
                    x:Name="DownloadButton"
                    Label="下载"
                    Icon="Download"
                    Click="DownloadButton_Click" />
                <AppBarButton
                    x:Name="RenameButton"
                    Label="重命名"
                    Icon="Edit"
                    Click="RenameButton_Click" />
                <AppBarButton
                    x:Name="DeleteButton"
                    Label="删除"
                    Icon="Delete"
                    Click="DeleteButton_Click" />
                <AppBarToggleButton
                    x:Name="HiddenFilesButton"
                    Label="显示隐藏文件"
                    Icon="View"
                    Click="HiddenFilesButton_Click" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                PlaceholderText="远程路径"
                FontFamily="Cascadia Mono"
                FontSize="12"
                IsSpellCheckEnabled="False"
                KeyDown="PathBox_KeyDown" />
            <StackPanel
                x:Name="DirectoryStatusPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ProgressRing
                    x:Name="DirectoryProgress"
                    Width="16"
                    Height="16"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="DirectoryStatus"
                    MaxWidth="220"
                    FontSize="12"
                    Foreground="{ThemeResource MutedTextBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <syncfusion:SfDataGrid
            x:Name="RemoteTable"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionUnit="Row"
            AllowSorting="True"
            AllowFiltering="True"
            AllowResizingColumns="True"
            AllowDraggingColumns="True"
            AllowGrouping="False"
            AllowRowHoverHighlighting="True"
            ShowRowHeader="False"
            HeaderRowHeight="40"
            RowHeight="40"
            FontSize="14"
            ColumnWidthMode="AutoLastColumnFill" />

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TransferStatus"
                Text="暂无文件传输"
                FontSize="12"
                Foreground="{ThemeResource MutedTextBrush}"
                TextTrimming="CharacterEllipsis" />
            <ProgressBar
                x:Name="TransferProgress"
                Grid.Column="1"
                Width="160"
                IsIndeterminate="True"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelTransferButton"
                Grid.Column="2"
                Content="&#xE711;"
                FontFamily="Segoe Fluent Icons"
                FontSize="16"
                Style="{StaticResource TitleBarSessionIconButtonStyle}"
                AutomationProperties.Name="取消文件传输"
                ToolTipService.ToolTip="取消文件传输"
                Visibility="Collapsed"
                Click="CancelTransferButton_Click" />
        </Grid>
    </Grid>
</UserControl>