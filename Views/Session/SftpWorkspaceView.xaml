<UserControl
    x:Class="FluentShell.Views.Session.SftpWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.DataGrid">
    <UserControl.Resources>
        <DataTemplate x:Key="RemoteFileNameCellTemplate">
            <Grid Margin="12,0,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Text="{Binding IconGlyph}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="0,8,0,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                PlaceholderText="远程路径"
                FontFamily="Cascadia Mono"
                FontSize="12"
                Height="36"
                MinHeight="0"
                Padding="10,8,6,8"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                IsSpellCheckEnabled="False"
                KeyDown="PathBox_KeyDown" />
            <StackPanel
                x:Name="WorkspaceOperationStatusPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="WorkspaceOperationProgress"
                    Width="16"
                    Height="16"
                    Visibility="Collapsed" />
                <Button
                    x:Name="TransferStatusButton"
                    Style="{StaticResource TitleBarSessionIconButtonStyle}"
                    Width="Auto"
                    MinWidth="0"
                    Padding="10,0"
                    AutomationProperties.Name="查看文件传输状态"
                    ToolTipService.ToolTip="查看文件传输状态"
                    Visibility="Collapsed"
                    Click="TransferStatusButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing x:Name="TransferStatusButtonRing" Width="16" Height="16" IsActive="True" />
                        <TextBlock x:Name="TransferStatusButtonLabel" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="WorkspaceOperationStatus"
                    MaxWidth="220"
                    FontSize="12"
                    Foreground="{ThemeResource MutedTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <CommandBar
                x:Name="Toolbar"
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="刷新"
                    Icon="Refresh"
                    ToolTipService.ToolTip="刷新"
                    Click="RefreshButton_Click" />
                <AppBarButton
                    x:Name="UploadButton"
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="上传"
                    Icon="Upload"
                    ToolTipService.ToolTip="上传"
                    Click="UploadButton_Click" />
                <AppBarButton
                    x:Name="DownloadButton"
                    Style="{StaticResource CommandBarIconButtonStyle}"
                    Label="下载"
                    Icon="Download"
                    ToolTipService.ToolTip="下载"
                    Click="DownloadButton_Click" />
            </CommandBar>
        </Grid>

        <!-- 非模态传输面板：锚在传输状态按钮上，开着不挡目录浏览，关掉传输继续。 -->
        <TeachingTip
            x:Name="TransferTip"
            Target="{x:Bind TransferStatusButton}"
            Title="文件传输"
            PreferredPlacement="Bottom"
            CloseButtonContent="关闭"
            ActionButtonClick="TransferTip_ActionButtonClick"
            Closed="TransferTip_Closed">
            <StackPanel Spacing="10" MinWidth="300" Margin="0,8,0,0">
                <TextBlock x:Name="TransferTipMessage" TextWrapping="Wrap" />
                <ProgressBar x:Name="TransferTipBar" Minimum="0" Maximum="100" />
                <TextBlock
                    x:Name="TransferTipBytes"
                    FontSize="12"
                    Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </TeachingTip>

        <syncfusion:SfDataGrid
            x:Name="RemoteTable"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionUnit="Row"
            AllowSorting="True"
            AllowFiltering="True"
            AllowResizingColumns="False"
            AllowDraggingColumns="False"
            AllowGrouping="False"
            AllowRowHoverHighlighting="True"
            ShowRowHeader="False"
            HeaderRowHeight="40"
            RowHeight="40"
            FontSize="14"
            ColumnWidthMode="AutoLastColumnFill" />
    </Grid>
</UserControl>