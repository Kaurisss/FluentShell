<UserControl
    x:Class="FluentShell.Views.Session.SftpWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.WinUI"
    xmlns:converters="using:FluentShell.Views.Converters"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.DataGrid">
    <UserControl.Resources>
        <!-- Keep the path fields' hover stroke consistent with the file grids.
             The stock focused accent stroke and disabled state remain native. -->
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource SubtleStrokeColor}" />
        <converters:FileIconSymbolConverter x:Key="FileIconSymbolConverter" />
        <Style x:Key="SftpMenuIconStyle" TargetType="icons:SymbolIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="IconVariant" Value="Regular" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <!-- The stock TextBox presenter uses Padding rather than the control's
             VerticalContentAlignment. Keep both single-line path fields identical. -->
        <Style x:Key="SftpPathInputStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource SubtleStrokeBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="Padding" Value="8,8,8,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
        </Style>
        <Style x:Key="SftpToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="SftpModifiedCellTemplate">
            <TextBlock Text="{Binding ModifiedLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding ModifiedLabel}" />
        </DataTemplate>
        <DataTemplate x:Key="SftpSizeCellTemplate">
            <TextBlock Text="{Binding SizeLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="SftpTypeCellTemplate">
            <TextBlock Text="{Binding TypeLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- The grid outer border supplies the final header's right edge. -->
        <Style x:Key="LastRemoteHeaderStyle" TargetType="syncfusion:GridHeaderCellControl">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <DataTemplate x:Key="RemoteFileNameCellTemplate">
            <Grid Margin="8,0,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <icons:SymbolIcon
                    Symbol="{Binding IsDirectory, Converter={StaticResource FileIconSymbolConverter}}"
                    Style="{StaticResource SftpMenuIconStyle}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}" FontSize="13" TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LocalFileNameCellTemplate">
            <Grid Margin="8,0,0,0" ColumnSpacing="6" Background="Transparent"
                  CanDrag="True" DragStarting="LocalItem_DragStarting">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <icons:SymbolIcon
                    Symbol="{Binding IsDirectory, Converter={StaticResource FileIconSymbolConverter}}"
                    Style="{StaticResource SftpMenuIconStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Padding="0,6,0,0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox Style="{StaticResource SftpPathInputStyle}" x:Name="LocalPathBox" PlaceholderText="本地路径" KeyDown="LocalPath_KeyDown" AutomationProperties.Name="本地路径" />
            <Border x:Name="LocalFilesFrame" Grid.Row="1" BorderThickness="1"
                    BorderBrush="{ThemeResource SubtleStrokeBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
            <syncfusion:SfDataGrid
                x:Name="LocalFiles" BorderThickness="0"
                BorderBrush="{ThemeResource SubtleStrokeBrush}"
                AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Extended" SelectionUnit="Row"
                CurrentCellBorderThickness="0"
                AllowSorting="True" AllowFiltering="False"
                AllowResizingColumns="False" AllowDraggingColumns="False"
                AllowGrouping="False" AllowRowHoverHighlighting="True"
                ShowRowHeader="False" HeaderRowHeight="34" RowHeight="34"
                FontSize="13" ColumnWidthMode="AutoLastColumnFill"
                AutomationProperties.Name="本地文件" />
            </Border>
        </Grid>
    <Grid x:Name="RemotePane" Grid.Column="1" Padding="0,6,0,0" RowSpacing="6"
          Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                PlaceholderText="远程路径"
                Style="{StaticResource SftpPathInputStyle}"
                KeyDown="PathBox_KeyDown" />
            <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                <Button x:Name="UploadButton" Style="{StaticResource SftpToolbarButtonStyle}" ToolTipService.ToolTip="上传" AutomationProperties.Name="上传">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="UploadFileMenuItem" Text="上传文件" FontFamily="Microsoft YaHei UI" Click="UploadButton_Click" />
                            <MenuFlyoutItem x:Name="UploadFolderMenuItem" Text="上传文件夹" FontFamily="Microsoft YaHei UI" Click="UploadFolder_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <icons:SymbolIcon Symbol="ArrowUpload" />
                </Button>
                <Button x:Name="DownloadButton" Style="{StaticResource SftpToolbarButtonStyle}" Click="DownloadButton_Click" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载"><icons:SymbolIcon Symbol="ArrowDownload" /></Button>
            </StackPanel>
        </Grid>

        <Border x:Name="RemoteTableFrame" Grid.Row="1" BorderThickness="1"
                BorderBrush="{ThemeResource SubtleStrokeBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
        <syncfusion:SfDataGrid
            x:Name="RemoteTable"
            BorderBrush="{ThemeResource SubtleStrokeBrush}"
            BorderThickness="0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Extended"
            SelectionUnit="Row"
            CurrentCellBorderThickness="0"
            AllowSorting="True"
            AllowFiltering="False"
            AllowResizingColumns="False"
            AllowDraggingColumns="False"
            AllowGrouping="False"
            AllowRowHoverHighlighting="True"
            ShowRowHeader="False"
            HeaderRowHeight="34"
            RowHeight="34"
            FontSize="13"
            ColumnWidthMode="AutoLastColumnFill" />
        </Border>

        <!-- Cover both the path toolbar and the file list without changing their layout. -->
        <Grid x:Name="DirectoryLoadingOverlay" Grid.RowSpan="2"
              Visibility="Collapsed" Background="Transparent">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.8" />
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        MaxWidth="280" Margin="24" Spacing="12">
                  <TextBlock x:Name="DirectoryLoadingText" Text="正在读取文件夹…" HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="DirectoryLoadingProgress" IsIndeterminate="False"
                             AutomationProperties.Name="正在读取文件夹" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
