<UserControl
    x:Class="FluentShell.Views.Session.SftpWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.DataGrid">
    <UserControl.Resources>
        <!-- The stock TextBox presenter uses Padding rather than the control's
             VerticalContentAlignment. Keep both single-line path fields identical. -->
        <Style x:Key="SftpPathInputStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="Padding" Value="8,8,8,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
        </Style>
        <Style x:Key="SftpToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="SftpModifiedCellTemplate">
            <TextBlock Text="{Binding ModifiedLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding ModifiedLabel}" />
        </DataTemplate>
        <DataTemplate x:Key="SftpSizeCellTemplate">
            <TextBlock Text="{Binding SizeLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="SftpTypeCellTemplate">
            <TextBlock Text="{Binding TypeLabel}" FontSize="13" Margin="8,0"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- The grid outer border supplies the final header's right edge. -->
        <Style x:Key="LastRemoteHeaderStyle" TargetType="syncfusion:GridHeaderCellControl">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <DataTemplate x:Key="RemoteFileNameCellTemplate">
            <Grid Margin="8,0,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Text="{Binding IconGlyph}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}" FontSize="13" TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Padding="0,6,0,0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SftpPathInputStyle}" x:Name="LocalPathBox" Grid.ColumnSpan="2" PlaceholderText="本地路径" KeyDown="LocalPath_KeyDown" AutomationProperties.Name="本地路径" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource SftpToolbarButtonStyle}" Click="LocalRefresh_Click" ToolTipService.ToolTip="刷新本地目录" AutomationProperties.Name="刷新本地目录"><SymbolIcon Symbol="Refresh" /></Button>
                </StackPanel>
            </Grid>
            <syncfusion:SfDataGrid
                x:Name="LocalFiles" Grid.Row="1"
                AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Extended" SelectionUnit="Row"
                CurrentCellBorderThickness="0"
                AllowSorting="True" AllowFiltering="True"
                AllowResizingColumns="False" AllowDraggingColumns="False"
                AllowGrouping="False" AllowRowHoverHighlighting="True"
                ShowRowHeader="False" HeaderRowHeight="34" RowHeight="34"
                FontSize="13" ColumnWidthMode="AutoLastColumnFill"
                AutomationProperties.Name="本地文件" />
        </Grid>
    <Grid Grid.Column="1" Padding="0,6,0,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                PlaceholderText="远程路径"
                Style="{StaticResource SftpPathInputStyle}"
                KeyDown="PathBox_KeyDown" />
            <StackPanel
                x:Name="WorkspaceOperationStatusPanel"
                Grid.Column="1"
                Margin="8,0,8,0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="WorkspaceOperationStatus"
                    MaxWidth="220"
                    FontSize="13"
                    Foreground="{ThemeResource MutedTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="Toolbar" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                <Button Style="{StaticResource SftpToolbarButtonStyle}" Click="RefreshButton_Click" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><SymbolIcon Symbol="Refresh" /></Button>
                <Button x:Name="UploadButton" Style="{StaticResource SftpToolbarButtonStyle}" Click="UploadButton_Click" ToolTipService.ToolTip="上传" AutomationProperties.Name="上传"><SymbolIcon Symbol="Upload" /></Button>
                <Button x:Name="DownloadButton" Style="{StaticResource SftpToolbarButtonStyle}" Click="DownloadButton_Click" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载"><SymbolIcon Symbol="Download" /></Button>
            </StackPanel>
        </Grid>

        <syncfusion:SfDataGrid
            x:Name="RemoteTable"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionUnit="Row"
            CurrentCellBorderThickness="0"
            AllowSorting="True"
            AllowFiltering="True"
            AllowResizingColumns="False"
            AllowDraggingColumns="False"
            AllowGrouping="False"
            AllowRowHoverHighlighting="True"
            ShowRowHeader="False"
            HeaderRowHeight="34"
            RowHeight="34"
            FontSize="13"
            ColumnWidthMode="AutoLastColumnFill" />

        <!-- Cover both the path toolbar and the file list without changing their layout. -->
        <Grid x:Name="DirectoryLoadingOverlay" Grid.RowSpan="2"
              Visibility="Collapsed" Background="Transparent">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.8" />
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        MaxWidth="280" Margin="24" Spacing="12">
                <TextBlock Text="正在读取文件夹…" HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="DirectoryLoadingProgress" IsIndeterminate="False"
                             AutomationProperties.Name="正在读取文件夹" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
