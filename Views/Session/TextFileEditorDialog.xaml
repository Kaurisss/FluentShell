<ContentDialog
    x:Class="FluentShell.Views.Session.TextFileEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文本查看与编辑"
    PrimaryButtonText="保存"
    CloseButtonText="关闭"
    DefaultButton="None"
    IsPrimaryButtonEnabled="False"
    CornerRadius="8"
    Opened="Dialog_Opened"
    Closing="Dialog_Closing"
    PrimaryButtonClick="Dialog_SaveClicked">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <Style x:Key="EditorDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="EditorDialogSaveStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.PrimaryButtonStyle>
        <StaticResource ResourceKey="EditorDialogSaveStyle" />
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <StaticResource ResourceKey="EditorDialogButtonStyle" />
    </ContentDialog.CloseButtonStyle>
    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
    </ContentDialog.KeyboardAccelerators>
    <Grid x:Name="EditorRoot" Width="900" Height="520" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PathText" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" PlaceholderText="查找文本（Ctrl+F）" MinWidth="100"
                     AutomationProperties.Name="查找文本" AutomationProperties.AutomationId="TextEditorFind"
                     IsSpellCheckEnabled="False" KeyDown="FindBox_KeyDown" />
            <Button Grid.Column="1" Content="下一个" Click="FindNext_Click" ToolTipService.ToolTip="查找下一处，Enter"
                    AutomationProperties.AutomationId="TextEditorFindNext" />
            <CheckBox x:Name="ReadOnlyBox" Grid.Column="2" Content="只读" IsChecked="True"
                      Checked="ReadOnly_Changed" Unchecked="ReadOnly_Changed" />
            <CheckBox x:Name="WrapBox" Grid.Column="3" Content="自动换行" IsChecked="False"
                      Checked="Wrap_Changed" Unchecked="Wrap_Changed" />
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="DiscardButton" Content="放弃修改并关闭" Visibility="Collapsed"
                        Click="Discard_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="3">
            <TextBox x:Name="EditorText" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono" FontSize="14" Padding="12"
                     IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="文件文本" AutomationProperties.AutomationId="TextEditorContent"
                     TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" />
            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40"
                          AutomationProperties.Name="正在读取文本" />
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FileStatus" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CaretStatus" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
        </Grid>
    </Grid>
</ContentDialog>
